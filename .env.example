TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional writable root used by the packaged sidecar. Tauri supplies this automatically.
TELEGRAM_CLIENT_DATA_ROOT=
# This must be this app's independent session, never the trading dashboard session.
TELEGRAM_SESSION_PATH=data/telegram_desktop/accounts/default/client
TELEGRAM_DATABASE_PATH=data/telegram_desktop/accounts/default/client.db
# Source-session import is explicit-only. Leave blank for a fresh machine.
TELEGRAM_SOURCE_SESSION_PATH=
TELEGRAM_AUTO_IMPORT_SOURCE=false
# Fresh-machine default is this app's private proxy catalog.
# An existing dashboard connection_routes.json may be referenced read-only only when explicitly chosen.
TELEGRAM_PROXY_CONFIG=data/telegram_desktop/proxies.json
# Optional explicit Xray executable path for managed VLESS routes.
TELEGRAM_XRAY_CORE=
# Direct Telegram connectivity is opt-in and must stay false unless explicitly requested.
TELEGRAM_ALLOW_DIRECT=false
TELEGRAM_BACKEND_HOST=127.0.0.1
TELEGRAM_BACKEND_PORT=8110

# Portable credential/session bootstrap is explicit-only. No executable-folder auto-discovery.
TELEGRAM_PORTABLE_CONFIG=
TELEGRAM_PORTABLE_MIRROR_CONFIG=
