TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional writable root used by the packaged sidecar. Tauri supplies this automatically.
TELEGRAM_CLIENT_DATA_ROOT=
# This must be the new app session, never the trading terminal session.
TELEGRAM_SESSION_PATH=data/telegram_desktop/accounts/default/client
TELEGRAM_DATABASE_PATH=data/telegram_desktop/accounts/default/client.db
# Optional read-only source path used for an explicit bootstrap/import.
TELEGRAM_SOURCE_SESSION_PATH=
# Keep false to require an explicit UI action before importing the source session.
TELEGRAM_AUTO_IMPORT_SOURCE=false
# Point this to the trading terminal's local proxy configuration.
TELEGRAM_PROXY_CONFIG=C:/path/to/DASHBOARD/data/config/connection_routes.json
TELEGRAM_ALLOW_DIRECT=false
TELEGRAM_BACKEND_HOST=127.0.0.1
TELEGRAM_BACKEND_PORT=8110
