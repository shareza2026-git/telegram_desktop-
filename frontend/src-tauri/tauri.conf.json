{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram Desktop",
  "version": "0.1.25",
  "identifier": "local.telegram.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Telegram Desktop",
        "width": 640,
        "height": 650,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "theme": "Light",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
